# ==============================================================================
# GENERAL SECURITY CONFIGURATION
# Disable directory indexing and restrict HTTP methods to prevent discovery.
# ==============================================================================
# Disable directory browsing/listing
Options -Indexes

# Restrict HTTP Request Methods (Allow only standard web methods)
<LimitExcept GET POST HEAD>
    Require all denied
</LimitExcept>

# Hide response headers where possible (Note: Server header requires main server config)
<IfModule mod_headers.c>
    Header unset X-Powered-By
</IfModule>

# Ensure ETags are calculated for automated 304 Not Modified checks
FileETag MTime Size

# WebAssembly (the chat's JPEG XL codec) has to be sent as application/wasm for browsers to compile it as it downloads
AddType application/wasm .wasm

# The fonts (assets/fonts/), in case the server's own list lacks them
AddType font/woff2 .woff2

# ==============================================================================
# PHP LIMITS
# Chat attachments can be up to 50 MB in one message, all files together (all 10 tickets,
# assets/php/chatAttachments.php), plus the rest of the form. Up to 10 files go in one, under PHP's max_file_uploads (20).
# Simply.com reads these from .htaccess.
# ==============================================================================
php_value upload_max_filesize 51M
php_value post_max_size 52M

# ==============================================================================
# CUSTOM ERROR PAGES
# Local paths only (a full URL would turn the error into a 302 redirect, and
# Apache rejects it outright for 401). Each page sets its own status code.
# ==============================================================================
ErrorDocument 400 /assets/php/statusCodesPages/400.php
ErrorDocument 401 /assets/php/statusCodesPages/401.php
ErrorDocument 403 /assets/php/statusCodesPages/403.php
ErrorDocument 404 /assets/php/statusCodesPages/404.php
ErrorDocument 410 /assets/php/statusCodesPages/410.php
ErrorDocument 423 /assets/php/statusCodesPages/423.php
ErrorDocument 500 /assets/php/statusCodesPages/500.php
ErrorDocument 502 /assets/php/statusCodesPages/502.php
ErrorDocument 503 /assets/php/statusCodesPages/503.php
ErrorDocument 504 /assets/php/statusCodesPages/504.php

# ==============================================================================
# SECURITY & CACHING HEADERS
# Provides protections against XSS, Clickjacking, MIME-sniffing, and data leaks.
# ==============================================================================
<IfModule mod_headers.c>
    # Prevent Clickjacking (iframe embedding)
    Header set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-type Sniffing
    Header set X-Content-Type-Options "nosniff"

    # Enforce HTTPS for 1 year, including subdomains
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Limit Referrer Information Shared Off-Site
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict Unused Hardware & Browser APIs
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Cross-Origin Protection Headers
    Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    Header set Cross-Origin-Resource-Policy "same-origin"

    # Content Security Policy (GIFs in the chat from Giphy's image servers). The fonts are our own (assets/fonts/).
    # 'wasm-unsafe-eval' lets the chat run the JPEG XL codec (WebAssembly, assets/js/vendor/jxl/) - it only allows
    # compiling WebAssembly, not eval() or inline scripts.
    # blob: lets the chat show a picture that's still being sent from the user's own device (a local object URL).
    Header always set X-XSS-Protection "0"
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://*.giphy.com; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self'; font-src 'self';"

    # --------------------------------------------------------------------------
    # SMART CACHING STRATEGY (Fixes Security Scanner & Handles 304 Validation)
    # --------------------------------------------------------------------------
    # Neither of the two below touches the scripts that send pictures: profile pictures, chat icons and banned pictures
    # (otherPages/avatar.php, chat/icon.php, admin/bannedPicture.php). They send their own
    # "private, max-age=31536000, immutable", as their address changes with the picture. Apache keeps PHP's headers apart
    # from the ones set here, so a "no-cache" from here would be sent next to theirs and win: every profile picture would
    # ask PHP again on every page, opening another chat too.

    # Default for Static Assets (Images, CSS, JS, Fonts): Cache locally for 90 days
    <FilesMatch "^(?!(avatar|icon|bannedPicture)\.php$)">
        Header set Cache-Control "max-age=7776000, public"
    </FilesMatch>

    # Dynamic Pages (HTML/PHP), robots.txt and the sitemap: Force browser to revalidate with 304 checks every time
    <FilesMatch "^(?!(avatar|icon|bannedPicture)\.php$)(.*\.(html|htm|php)|robots\.txt|sitemap\.xml)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# ==============================================================================
# REWRITE RULES & FILE ACCESS RESTRICTIONS
# Protects hidden files, backups, logs, and manages clean URLs.
# ==============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect HTTP requests to HTTPS before serving any content.
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Wordle used to be called Ordle and live at /games/ordle/, so old links and bookmarks still work.
    RewriteRule ^games/ordle(/.*)?$ /games/wordle$1 [R=301,L]

    # The pages that used to live at a long address (/otherPages/profile, /userMgmt/login, /games/spaceOreMiner/)
    # now have a short one (SHORT ADDRESSES below), so old links and bookmarks are sent on to it. Only for GET/HEAD:
    # a redirected POST turns into a GET and loses its form, so a form or a game that was open before the change still
    # posts to the old address, which still works. THE_REQUEST is what the browser itself asked for, so the short
    # address (rewritten to the long one further down) isn't sent back here in a loop.
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} ^[A-Z]+\ /(otherPages|userMgmt)/
    RewriteRule ^(?:otherPages|userMgmt)/(profile|settings|notifications|feedback|avatar|login|onboarding)(?:\.php)?$ /$1 [R=301,L]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{THE_REQUEST} ^[A-Z]+\ /games/spaceOreMiner
    RewriteRule ^games/spaceOreMiner(/.*)?$ /games/ore-mining-inc$1 [R=301,L]

    # Ore Mining Inc. used to be called Space Ore Miner and live at /games/space-ore-miner/, so old links and
    # bookmarks still work. GET/HEAD only for the same reason as above: a game opened before the rename still saves to
    # the old address until it's reloaded, so that's still rewritten to the folder under SHORT ADDRESSES.
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteRule ^games/space-ore-miner(/.*)?$ /games/ore-mining-inc$1 [R=301,L]
    RewriteRule ^docs/games/space-ore-miner$ /docs/games/ore-mining-inc [R=301,L]

    # 1. ALLOW ACCESS TO .well-known (Required for SSL certificates like Let's Encrypt)
    RewriteRule ^\.well-known/ - [L]

    # 2. DENY ACCESS TO ALL HIDDEN FILES (dotfiles like .env, .git, .htaccess, etc.)
    RewriteCond %{REQUEST_URI} ^/\. [OR]
    RewriteCond %{REQUEST_URI} /\./ [OR]
    RewriteCond %{REQUEST_URI} /\.[^/]+
    RewriteRule ^ - [F,L]

    # 3. DENY ACCESS TO SENSITIVE FILE EXTENSIONS (Backups, SQL dumps, configs, logs)
    RewriteCond %{REQUEST_URI} \.(bak|config|sql|ini|log|sh|inc|swp|dist|env|yml|yaml)$ [NC]
    RewriteRule ^ - [F,L]

    # --------------------------------------------------------------------------
    # UNIVERSAL FILE EXTENSION REMOVAL (.html, .php, .htm)
    # --------------------------------------------------------------------------
    # A. Redirect external requests containing extensions to their clean URL version
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.(html|htm|php)[\ \?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # --------------------------------------------------------------------------
    # SHORT ADDRESSES
    # --------------------------------------------------------------------------
    # The files stay in their folders, but the address bar never shows the folder's name: /profile is
    # otherPages/profile.php, /login is userMgmt/login.php and /games/ore-mining-inc/ is games/spaceOreMiner/.
    # The code links to the short ones; the old long ones are redirected near the top.
    RewriteRule ^(profile|settings|notifications|feedback|avatar)$ otherPages/$1.php [L]
    RewriteRule ^nav-updates$ otherPages/navUpdates.php [L]
    RewriteRule ^(login|onboarding)$ userMgmt/$1.php [L]

    # Without the slash Apache would add it itself, to the folder's real name, so it's added here first.
    # games/space-ore-miner/ is the game's old name, only still reached by POSTs (see near the top).
    RewriteRule ^games/ore-mining-inc$ /games/ore-mining-inc/ [R=301,L]
    RewriteRule ^games/(?:ore-mining-inc|space-ore-miner)/(.*)$ games/spaceOreMiner/$1 [L]

    # B. Serve .html if the clean URL matches a .html file
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # C. Serve .php if the clean URL matches a .php file
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]

    # D. Serve .htm if the clean URL matches a .htm file
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.htm -f
    RewriteRule ^(.*)$ $1.htm [L]
</IfModule>